rules_version = '2';

// ═══════════════════════════════════════════════════════════
// Habesha Hub — Firestore security rules
// Admin = samuelefriem@gmail.com. Cloud Functions & Node scripts use the
// Admin SDK and are NOT affected by these rules.
// Deploy:  firebase deploy --only firestore:rules
// ═══════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid()      { return request.auth.uid; }
    function isAdmin()  {
      return signedIn() && (request.auth.uid == 'W3z67R3wiXUVvcPFDS0oxgfaDlj1'
        || (request.auth.token.email == 'samuelefriem@gmail.com'
            && request.auth.token.email_verified == true));
    }
    // a real account (email/Apple/Google) — not an anonymous guest
    function realUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    // Approval: the switch is app_config/members.enforce (old app versions keep working until it is on).
    function approvalOn() {
      return exists(/databases/$(database)/documents/app_config/members)
        && get(/databases/$(database)/documents/app_config/members).data.get('enforce', false) == true;
    }
    function isMember() {
      return request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(uid()))
        && get(/databases/$(database)/documents/members/$(uid())).data.status == 'approved';
    }
    function canAct() { return realUser() && (isAdmin() || !approvalOn() || isMember()); }
    function changed()  { return request.resource.data.diff(resource.data).affectedKeys(); }
    function bizOwner(bizId) {
      return signedIn() &&
        get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerId == uid();
    }

    // ── Businesses ─────────────────────────────────────────
    match /businesses/{bizId} {
      allow read: if true;
      // admin may publish directly (e.g. an approved suggestion)
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.isPremium != true);
      allow update: if isAdmin()
        // owner may edit everything except approval / premium / ownership
        || (signedIn() && resource.data.ownerId == uid()
            && !changed().hasAny(['status', 'isPremium', 'ownerId', 'premiumUntil', 'premiumSince', 'premiumTrial']))
        // anyone: view counter
        || changed().hasOnly(['viewCount'])
        // logged-in users: add ONE rating (average must stay 0–5)
        || (signedIn() && changed().hasOnly(['rating', 'ratingCount'])
            && request.resource.data.rating is number
            && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
            && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1)
        // logged-in users: review counter +1
        || (signedIn() && changed().hasOnly(['reviewCount'])
            && request.resource.data.reviewCount == resource.data.get('reviewCount', 0) + 1);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == uid());

      // monthly stats for the owner: anyone may add +1 to one counter, only owner/admin read
      match /stats/{month} {
        function statKeys() { return ['views', 'calls', 'directions', 'website', 'chats']; }
        function plusOne(k) {
          return request.resource.data.get(k, 0) == resource.data.get(k, 0)
              || request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1;
        }
        allow read: if isAdmin() || bizOwner(bizId);
        allow create: if month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(statKeys()) && request.resource.data.size() == 1
          && request.resource.data.values()[0] == 1;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(statKeys())
          && request.resource.data.diff(resource.data).affectedKeys().size() == 1
          && plusOne('views') && plusOne('calls') && plusOne('directions') && plusOne('website') && plusOne('chats');
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == uid()
                      && request.resource.data.comment.size() <= 2000;
        allow delete: if isAdmin() || (signedIn() && resource.data.userId == uid());
      }
    }

    // ── Chat between a user and a business ("bizId_userId") ─
    match /chats/{chatId} {
      function chatAllowed() {
        return isAdmin()
          || (signedIn() && chatId.split('_')[1] == uid())
          || bizOwner(chatId.split('_')[0]);
      }
      // ownerId (for the owner's inbox) must be the real owner of the business
      function ownerOk() {
        return !('ownerId' in request.resource.data)
          || request.resource.data.ownerId == get(/databases/$(database)/documents/businesses/$(chatId.split('_')[0])).data.ownerId;
      }
      allow get: if chatAllowed();
      // the owner's inbox: list of chats for his businesses
      allow list: if isAdmin() || (signedIn() && resource.data.ownerId == uid());
      allow create, update: if chatAllowed() && ownerOk();
      allow delete: if chatAllowed();
      match /messages/{msgId} {
        allow read: if chatAllowed();
        allow create: if chatAllowed() && request.resource.data.text.size() <= 2000;
        allow update, delete: if isAdmin();
      }
    }

    // ── Business bookings (restaurant / barber / hotel) ────
    match /bookings/{id} {
      allow create: if request.resource.data.status == 'pending'
        && (!approvalOn() || canAct());
      allow read: if isAdmin()
        || (signedIn() && (resource.data.ownerId == uid() || resource.data.userId == uid()));
      allow update, delete: if isAdmin() || (signedIn() && resource.data.ownerId == uid());
    }

    // ── Events: only approved ones are public; verified organizers publish at once ──
    function verifiedOrganizer() {
      return signedIn() && get(/databases/$(database)/documents/users/$(uid())).data.get('verifiedOrganizer', false) == true;
    }
    function eventOk() {
      let e = request.resource.data;
      return e.keys().hasOnly(['title', 'artistName', 'artistId', 'category', 'startAt', 'venue', 'city', 'area', 'description',
          'flyerUrl', 'ticketUrl', 'discountCode', 'discountText', 'discountExpiresAt', 'organizerId', 'organizerVerified',
          'status', 'interestedCount', 'createdAt', 'updatedAt'])
        && e.organizerId == uid() && e.title is string && e.title.size() <= 120 && e.get('description', '').size() <= 3000
        && (e.get('ticketUrl', '') == '' || e.ticketUrl.matches('https://[^ ]+'))
        && (e.status == 'pending' && e.organizerVerified == false
            || e.status == 'approved' && e.organizerVerified == true && verifiedOrganizer());
    }
    match /events/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (signedIn() && resource.data.organizerId == uid());
      allow create: if isAdmin() || (canAct() && eventOk() && request.resource.data.interestedCount == 0);
      allow update: if isAdmin() || (canAct() && resource.data.organizerId == uid() && resource.data.status != 'removed'
        && eventOk() && request.resource.data.interestedCount == resource.data.interestedCount);
      allow delete: if isAdmin() || (signedIn() && resource.data.organizerId == uid());
      // "Interested": one per person; the count is kept by a Cloud Function
      match /interested/{u} {
        allow read: if signedIn() && (uid() == u || isAdmin());
        allow create: if signedIn() && uid() == u && request.resource.data.keys().hasOnly(['at']);
        allow delete: if signedIn() && uid() == u;
      }
    }
    match /organizerApplications/{u} {
      allow read: if isAdmin() || (signedIn() && uid() == u);
      allow create, update: if isAdmin() || (realUser() && uid() == u && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'city', 'link', 'contact', 'email', 'status', 'createdAt']));
      allow delete: if isAdmin();
    }

    // ── Website requests (Habesha Tech Help): the person sees and deletes their own, only the admin sees all ──
    function webReqOk(d) {
      return d.keys().hasOnly(['uid', 'businessId', 'businessName', 'contactName', 'phone', 'email', 'city', 'country',
                               'package', 'hasDomain', 'domain', 'languages', 'description', 'contactTime', 'consent',
                               'status', 'createdAt'])
        && d.uid == uid() && d.status == 'new' && d.consent == true
        && d.businessName is string && d.businessName.size() > 0 && d.businessName.size() <= 120
        && d.contactName is string && d.contactName.size() > 0 && d.contactName.size() <= 120
        && d.phone is string && d.phone.size() >= 8 && d.phone.size() <= 20
        && d.email is string && d.email.size() <= 120
        && d.city is string && d.city.size() <= 120 && d.country is string && d.country.size() <= 120
        && d.package is string && d.package.size() <= 30
        && d.hasDomain is bool && d.domain is string && d.domain.size() <= 120
        && d.languages is list && d.languages.size() <= 6
        && d.description is string && d.description.size() <= 1000
        && d.contactTime is string && d.contactTime.size() <= 120
        && d.businessId is string && d.businessId.size() <= 60
        && d.createdAt == request.time;
    }
    match /websiteRequests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == uid());
      allow create: if realUser() && webReqOk(request.resource.data);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == uid());
    }
    // the admin's own notes about a request
    match /websiteRequestNotes/{id} {
      allow read, write: if isAdmin();
    }

    // ── Messages from Habesha Hub to one person ──
    match /notices/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.toUid == uid());
      allow create: if isAdmin();
      allow update: if isAdmin() || (signedIn() && resource.data.toUid == uid() && changed().hasOnly(['read']));
      allow delete: if isAdmin() || (signedIn() && resource.data.toUid == uid());
    }

    // ── Members: private details, only the person and the admin ──
    match /members/{id} {
      allow read: if isAdmin() || (signedIn() && uid() == id);
      allow create: if realUser() && uid() == id
        && request.auth.token.email_verified == true
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'phone', 'city', 'address', 'email', 'status', 'createdAt']);
      allow update: if isAdmin()
        || (signedIn() && uid() == id && changed().hasOnly(['name', 'phone', 'city', 'address']));
      allow delete: if isAdmin() || (signedIn() && uid() == id);
    }

    // ── Marketplace (buy & sell) ───────────────────────────
    match /marketplace/{id} {
      allow read: if true;
      // New and edited listings must wait for admin approval (approved == false).
      allow create: if isAdmin()
        || (canAct() && request.resource.data.userId == uid()
            && request.resource.data.approved == false);
      allow update: if isAdmin()
        || (realUser() && resource.data.userId == uid() && request.resource.data.userId == uid()
            && request.resource.data.approved == false)
        // the seller marks it sold / rented / available again without a new approval
        || (realUser() && resource.data.userId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt'])
            && request.resource.data.status in ['available', 'done']);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == uid());
    }

    // ── Housing (Market > Housing): rent out / look for flats and rooms ──
    // Only approved (and recently rented) listings are public. Owners edit their own;
    // every edit goes back to "pending". Without a new approval the owner may only
    // switch approved <-> rented. Only the admin approves. Never an exact address.
    match /housing/{id} {
      allow read: if resource.data.status in ['approved', 'rented'] || isAdmin()
        || (signedIn() && resource.data.ownerId == uid());
      allow create: if canAct()
        && request.resource.data.ownerId == uid()
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['address'])
        && request.resource.data.photos.size() <= 10;
      allow update: if isAdmin()
        || (realUser() && resource.data.ownerId == uid()
            && request.resource.data.ownerId == uid()
            && request.resource.data.status == 'pending'
            && !request.resource.data.keys().hasAny(['address'])
            && request.resource.data.photos.size() <= 10)
        || (realUser() && resource.data.ownerId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rentedAt', 'updatedAt'])
            && ((resource.data.status == 'approved' && request.resource.data.status == 'rented')
                || (resource.data.status == 'rented' && request.resource.data.status == 'approved')));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == uid());
    }

    // ── Home shops (ቤት ዕዳጋ): small sellers from home ───────
    // Only approved shops are public. Owners edit their own shop; every edit goes back
    // to "pending". Without a new approval the owner may only change availability or
    // pause / open the shop. Only the admin approves. Never an address (area only).
    match /homeShops/{shopId} {
      allow read: if resource.data.status == 'approved' || isAdmin()
        || (signedIn() && resource.data.ownerId == uid());
      allow create: if canAct()
        && request.resource.data.ownerId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.rating == 0
        && !request.resource.data.keys().hasAny(['address']);
      allow update: if isAdmin()
        || (realUser() && resource.data.ownerId == uid()
            && request.resource.data.ownerId == uid()
            && request.resource.data.status == 'pending'
            && request.resource.data.get('rating', 0) == resource.data.get('rating', 0)
            && !request.resource.data.keys().hasAny(['address']))
        || (realUser() && resource.data.ownerId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability', 'status', 'updatedAt'])
            && request.resource.data.availability in ['now', 'order']
            && (request.resource.data.status == resource.data.status
                || (resource.data.status == 'approved' && request.resource.data.status == 'paused')
                || (resource.data.status == 'paused' && request.resource.data.status == 'approved')));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == uid());

      match /products/{productId} {
        function shop() { return get(/databases/$(database)/documents/homeShops/$(shopId)).data; }
        allow read: if shop().status == 'approved' || isAdmin()
          || (signedIn() && shop().ownerId == uid());
        allow write: if isAdmin()
          || (realUser() && shop().ownerId == uid() && shop().status == 'pending');
      }
    }

    // App switches the admin turns on/off (e.g. the Home shops holiday banner)
    // ── Habesha Hub Service: one wekil per country ─────────
    function isWekilFor(c) {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/wekils/$(request.auth.token.email))
        && get(/databases/$(database)/documents/wekils/$(request.auth.token.email)).data.country == c;
    }
    // wekil for an ISO country code ("NO"), used by the service providers
    function isWekilForCode(code) {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/wekils/$(request.auth.token.email))
        && get(/databases/$(database)/documents/wekils/$(request.auth.token.email)).data.get('code', '') == code;
    }
    match /wekils/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow write: if isAdmin();
    }
    // a request is private: the user, the wekil of that country and the admin
    match /serviceRequests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid()) || isWekilFor(resource.data.country);
      allow create: if realUser() && request.auth.token.email_verified == true
        && request.resource.data.userId == uid() && request.resource.data.status == 'new'
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.keys().hasOnly(['userId', 'country', 'category', 'name', 'phone', 'city', 'when', 'text', 'status', 'note', 'createdAt', 'updatedAt']);
      allow update: if isAdmin()
        || (isWekilFor(resource.data.country) && changed().hasOnly(['status', 'note', 'updatedAt'])
            && request.resource.data.status in ['new', 'working', 'done', 'cancelled'])
        || (signedIn() && resource.data.userId == uid() && changed().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    match /app_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Anonymous service providers (only admin edits) ─────
    function wekilSvcOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['publicName', 'description', 'group', 'subcategory', 'category', 'country', 'city', 'area',
          'priceRange', 'languages', 'travels', 'travelsWhere', 'whatsapp', 'phone', 'links', 'sampleImages', 'sampleVideoUrls',
          'ownerId', 'contactMode', 'status', 'available', 'createdAt', 'updatedAt', 'translations', 'rating', 'ratingCount', 'reviewCount'])
        && d.contactMode == 'direct' && d.group in ['weddings', 'travel', 'music']
        && d.publicName is string && d.publicName.size() > 0 && d.publicName.size() <= 80
        && d.get('description', '').size() <= 2000 && d.country is string && d.country.size() == 2
        && d.sampleImages.size() <= 5 && d.sampleVideoUrls.size() <= 3;
    }
    function svcOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['publicName', 'description', 'group', 'subcategory', 'category', 'country', 'city', 'area',
          'priceRange', 'languages', 'travels', 'travelsWhere', 'whatsapp', 'phone', 'links', 'sampleImages', 'sampleVideoUrls',
          'ownerId', 'contactMode', 'status', 'available', 'createdAt', 'updatedAt', 'translations', 'rating', 'ratingCount', 'reviewCount'])
        && d.ownerId == uid() && d.contactMode == 'direct' && d.group in ['weddings', 'travel', 'music']
        && d.status == 'pending' && d.available == false
        && d.publicName is string && d.publicName.size() > 0 && d.publicName.size() <= 80
        && d.get('description', '').size() <= 2000 && d.country is string && d.country.size() == 2
        && d.sampleImages.size() <= 5 && d.sampleVideoUrls.size() <= 3;
    }
    match /anonymous_services/{id} {
      // only approved (available) services; the owner sees their own, the admin all
      allow read: if resource.data.get('available', false) == true || isAdmin()
        || (signedIn() && resource.data.get('ownerId', '') == uid())
        || isWekilForCode(resource.data.get('country', ''));
      allow write: if isAdmin();
      // only the wekil of the country adds and edits providers (published at once)
      allow create: if isWekilForCode(request.resource.data.country) && wekilSvcOk();
      allow update: if isWekilForCode(resource.data.get('country', '')) && isWekilForCode(request.resource.data.country)
        && (wekilSvcOk() || changed().hasOnly(['available', 'status', 'updatedAt']));
      allow delete: if (signedIn() && resource.data.get('ownerId', '') == uid()) || isWekilForCode(resource.data.get('country', ''));

      // Reviews: one per booking (review ID = booking ID), only by the customer
      // of a completed or paid booking for THIS provider.
      match /reviews/{bookingId} {
        function booking() {
          return get(/databases/$(database)/documents/service_bookings/$(bookingId)).data;
        }
        function validReview() {
          return request.resource.data.userId == uid()
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
            && request.resource.data.comment.size() <= 500;
        }
        allow read: if true;
        allow create: if signedIn() && validReview()
          && booking().userId == uid()
          && booking().serviceId == id
          && (booking().status == 'completed' || booking().paid == true);
        allow update: if signedIn() && resource.data.userId == uid() && validReview();
        allow delete: if isAdmin() || (signedIn() && resource.data.userId == uid());
      }
    }

    // ── Service bookings + receipts ────────────────────────
    match /service_bookings/{id} {
      allow create: if canAct()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'created'
        && !('amount' in request.resource.data)
        && !('paid' in request.resource.data);
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow update, delete: if isAdmin();
    }

    // ── Video likes (count kept by Cloud Function) ─────────
    match /video_likes/{videoKey} {
      allow read: if true;
      allow write: if isAdmin();
      match /users/{userId} {
        allow read: if signedIn() && uid() == userId;
        allow create: if signedIn() && uid() == userId
          && request.resource.data.keys().hasOnly(['serviceId', 'createdAt']);
        allow delete: if signedIn() && uid() == userId;
      }
    }

    // ── Community help: claim / report / suggest ──────────
    // Owner wants to take over an imported business
    match /claims/{id} {
      allow create: if realUser()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.message.size() <= 2000
        && request.resource.data.name.size() <= 200;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow update, delete: if isAdmin();
    }
    // "Report wrong info" (guests too)
    match /reports/{id} {
      allow create: if request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(
             ['businessId', 'businessName', 'reason', 'note', 'userId', 'status', 'createdAt', 'kind'])
        && request.resource.data.note.size() <= 1000
        && (request.resource.data.userId == null || (signedIn() && request.resource.data.userId == uid()));
      allow read, update, delete: if isAdmin();
    }
    // Missing business suggested by a user
    match /suggestions/{id} {
      allow create: if realUser()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.name.size() <= 200
        && request.resource.data.note.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // ── App settings (payment numbers) ─────────────────────
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Users (FCM token etc.) ─────────────────────────────
    match /users/{userId} {
      // "unlocks" is set only by the redeemCode function, never by the app
      allow read: if (signedIn() && uid() == userId) || isAdmin();
      allow create: if signedIn() && uid() == userId
        && !request.resource.data.keys().hasAny(['unlocks', 'unlockPhone', 'verifiedOrganizer']);
      allow update: if isAdmin() || (signedIn() && uid() == userId
        && !changed().hasAny(['unlocks', 'unlockPhone', 'verifiedOrganizer']));
      allow delete: if signedIn() && uid() == userId;
    }

    // ── Paid content unlocked with a code (see redeemCode) ─
    match /unlock_codes/{code} {
      allow read, write: if isAdmin();
    }
    // Extra driving theory questions: only for users who unlocked theory_pro
    match /theory_pro/{doc} {
      allow read: if isAdmin() || (signedIn()
        && get(/databases/$(database)/documents/users/$(uid())).data.get('unlocks', {}).get('theory_pro', false) == true);
      allow write: if isAdmin();
    }

    // ── Contact form ───────────────────────────────────────
    match /contact_messages/{id} {
      allow create: if request.resource.data.keys().hasAll(['message'])
                    && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // ── Notifications queue ────────────────────────────────
    match /notifications/{id} {
      allow create: if signedIn();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow update, delete: if isAdmin();
    }

    // ── Travel requests ────────────────────────────────────
    match /travel_requests/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Habesha Books (digital books, read with a verified email) ──
    // authors/{email}: who may upload books — only admin decides
    function verifiedEmail() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isAuthor() { return verifiedEmail() && exists(/databases/$(database)/documents/authors/$(myEmail())); }
    function bookAuthor(bookId) {
      return signedIn() && get(/databases/$(database)/documents/books/$(bookId)).data.authorId == uid();
    }
    function hasBookAccess(bookId) {
      return verifiedEmail() && (
        exists(/databases/$(database)/documents/books/$(bookId)/access/$(myEmail()))
        || exists(/databases/$(database)/documents/books/$(bookId)/domains/$(myEmail().split('@')[1])));
    }
    match /authors/{email} {
      allow read: if isAdmin() || (verifiedEmail() && myEmail() == email);
      allow write: if isAdmin();
    }
    match /books/{bookId} {
      allow read: if resource.data.published == true || isAdmin()
        || (signedIn() && resource.data.authorId == uid());
      allow create: if isAdmin() || (isAuthor()
        && request.resource.data.authorId == uid()
        && request.resource.data.published == false);
      allow update: if isAdmin() || (isAuthor()
        && resource.data.authorId == uid() && request.resource.data.authorId == uid());
      allow delete: if isAdmin() || (isAuthor() && resource.data.authorId == uid());

      // emails that may read this book (doc id = lower-case email)
      match /access/{email} {
        allow read: if isAdmin() || bookAuthor(bookId) || (verifiedEmail() && myEmail() == email);
        allow write: if isAdmin() || (isAuthor() && bookAuthor(bookId));
        // a reader unlocks the book with an unused code from the printed book
        // (same batch marks the code as used by this email)
        allow create: if verifiedEmail() && myEmail() == email
          && request.resource.data.keys().hasOnly(['email', 'code', 'addedAt'])
          && request.resource.data.code is string
          && get(/databases/$(database)/documents/book_codes/$(request.resource.data.code)).data.usedBy == null
          && getAfter(/databases/$(database)/documents/book_codes/$(request.resource.data.code)).data.usedBy == email
          && getAfter(/databases/$(database)/documents/book_codes/$(request.resource.data.code)).data.bookId == bookId;
      }
      // whole school: every verified email @domain may read
      match /domains/{domain} {
        allow read: if isAdmin() || bookAuthor(bookId) || (verifiedEmail() && myEmail().split('@')[1] == domain);
        allow write: if isAdmin() || (isAuthor() && bookAuthor(bookId));
      }
      // interactive lessons (HTML book): readers with access read, the author writes
      match /lessons/{lessonId} {
        allow read: if isAdmin() || bookAuthor(bookId) || hasBookAccess(bookId);
        allow write: if isAdmin() || (isAuthor() && bookAuthor(bookId));
      }
      // reading progress, written by the reader, seen by the author
      match /reads/{email} {
        allow read, delete: if isAdmin() || bookAuthor(bookId);
        allow create, update: if verifiedEmail() && myEmail() == email && hasBookAccess(bookId)
          && request.resource.data.keys().hasOnly(['email', 'lastPage', 'updatedAt'])
          && request.resource.data.email == email && request.resource.data.lastPage is int;
      }
      // workbook pages rebuilt as web content (text, lines, photo keys) — same access as the book
      match /wpages/{pageId} {
        allow read: if isAdmin() || bookAuthor(bookId) || hasBookAccess(bookId);
        allow write: if isAdmin() || (isAuthor() && bookAuthor(bookId));
      }
      // exercise book: what a reader wrote on a page, only they read and write it
      match /ink/{email}/pages/{page} {
        allow read, write: if verifiedEmail() && myEmail() == email
          && (hasBookAccess(bookId) || bookAuthor(bookId) || isAdmin())
          && (request.resource == null || (request.resource.data.keys().hasOnly(['s', 't', 'updatedAt'])
            && request.resource.data.s is string && request.resource.data.s.size() < 900000));
      }
    }

    // one-time unlock codes printed inside the paper book (doc id = code)
    match /book_codes/{code} {
      allow get: if verifiedEmail();
      allow list: if isAdmin() || (signedIn() && resource.data.authorId == uid());
      allow create: if request.resource.data.usedBy == null
        && (isAdmin() || (isAuthor() && request.resource.data.authorId == uid()
                          && bookAuthor(request.resource.data.bookId)));
      allow update: if isAdmin() || (isAuthor() && resource.data.authorId == uid())
        || (verifiedEmail() && resource.data.usedBy == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
            && request.resource.data.usedBy == myEmail()
            && request.resource.data.usedAt == request.time
            && existsAfter(/databases/$(database)/documents/books/$(resource.data.bookId)/access/$(myEmail())));
      allow delete: if isAdmin() || (isAuthor() && resource.data.authorId == uid());
    }
    // devices per reader email: max 3, a reader can add but never remove; authors reset
    match /books_devices/{email} {
      allow read: if isAdmin() || isAuthor() || (verifiedEmail() && myEmail() == email);
      allow create: if verifiedEmail() && myEmail() == email
        && request.resource.data.keys().hasOnly(['email', 'devices'])
        && request.resource.data.devices.size() <= 3;
      allow update: if verifiedEmail() && myEmail() == email
        && request.resource.data.keys().hasOnly(['email', 'devices'])
        && request.resource.data.devices.size() <= 3
        && request.resource.data.devices.keys().hasAll(resource.data.devices.keys());
      allow delete: if isAdmin() || isAuthor();
    }

    // free sample lesson: recorded voices (public), only authors/admin change them
    match /books_sample/{id} {
      allow read: if true;
      allow write: if isAdmin() || isAuthor();
    }

    // ── Everything else (old Connect / Forum / Events) ─────
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
