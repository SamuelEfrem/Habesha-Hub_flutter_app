rules_version = '2';

// ═══════════════════════════════════════════════════════════
// Habesha Hub — Firestore security rules
// Admin = samuelefriem@gmail.com. Cloud Functions & Node scripts use the
// Admin SDK and are NOT affected by these rules.
// Deploy:  firebase deploy --only firestore:rules
// ═══════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid()      { return request.auth.uid; }
    function isAdmin()  {
      return signedIn() && (request.auth.uid == 'W3z67R3wiXUVvcPFDS0oxgfaDlj1'
        || (request.auth.token.email == 'samuelefriem@gmail.com'
            && request.auth.token.email_verified == true));
    }
    // a real account (email/Apple/Google) — not an anonymous guest
    function realUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function changed()  { return request.resource.data.diff(resource.data).affectedKeys(); }
    function bizOwner(bizId) {
      return signedIn() &&
        get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerId == uid();
    }

    // ── Businesses ─────────────────────────────────────────
    match /businesses/{bizId} {
      allow read: if true;
      // admin may publish directly (e.g. an approved suggestion)
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.isPremium != true);
      allow update: if isAdmin()
        // owner may edit everything except approval / premium / ownership
        || (signedIn() && resource.data.ownerId == uid()
            && !changed().hasAny(['status', 'isPremium', 'ownerId']))
        // anyone: view counter
        || changed().hasOnly(['viewCount'])
        // logged-in users: add ONE rating (average must stay 0–5)
        || (signedIn() && changed().hasOnly(['rating', 'ratingCount'])
            && request.resource.data.rating is number
            && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
            && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1)
        // logged-in users: review counter +1
        || (signedIn() && changed().hasOnly(['reviewCount'])
            && request.resource.data.reviewCount == resource.data.get('reviewCount', 0) + 1);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == uid());

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == uid()
                      && request.resource.data.comment.size() <= 2000;
        allow delete: if isAdmin() || (signedIn() && resource.data.userId == uid());
      }
    }

    // ── Chat between a user and a business ("bizId_userId") ─
    match /chats/{chatId} {
      function chatAllowed() {
        return isAdmin()
          || (signedIn() && chatId.split('_')[1] == uid())
          || bizOwner(chatId.split('_')[0]);
      }
      allow read, write: if chatAllowed();
      match /messages/{msgId} {
        allow read: if chatAllowed();
        allow create: if chatAllowed() && request.resource.data.text.size() <= 2000;
        allow update, delete: if isAdmin();
      }
    }

    // ── Business bookings (restaurant / barber / hotel) ────
    match /bookings/{id} {
      allow create: if request.resource.data.status == 'pending';
      allow read: if isAdmin()
        || (signedIn() && (resource.data.ownerId == uid() || resource.data.userId == uid()));
      allow update, delete: if isAdmin() || (signedIn() && resource.data.ownerId == uid());
    }

    // ── Marketplace (buy & sell) ───────────────────────────
    match /marketplace/{id} {
      allow read: if true;
      // New and edited listings must wait for admin approval (approved == false).
      allow create: if isAdmin()
        || (realUser() && request.resource.data.userId == uid()
            && request.resource.data.approved == false);
      allow update: if isAdmin()
        || (realUser() && resource.data.userId == uid() && request.resource.data.userId == uid()
            && request.resource.data.approved == false);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == uid());
    }

    // ── Anonymous service providers (only admin edits) ─────
    match /anonymous_services/{id} {
      allow read: if true;
      allow write: if isAdmin();

      // Reviews: one per booking (review ID = booking ID), only by the customer
      // of a completed or paid booking for THIS provider.
      match /reviews/{bookingId} {
        function booking() {
          return get(/databases/$(database)/documents/service_bookings/$(bookingId)).data;
        }
        function validReview() {
          return request.resource.data.userId == uid()
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
            && request.resource.data.comment.size() <= 500;
        }
        allow read: if true;
        allow create: if signedIn() && validReview()
          && booking().userId == uid()
          && booking().serviceId == id
          && (booking().status == 'completed' || booking().paid == true);
        allow update: if signedIn() && resource.data.userId == uid() && validReview();
        allow delete: if isAdmin() || (signedIn() && resource.data.userId == uid());
      }
    }

    // ── Service bookings + receipts ────────────────────────
    match /service_bookings/{id} {
      allow create: if realUser()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'created'
        && !('amount' in request.resource.data)
        && !('paid' in request.resource.data);
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow update, delete: if isAdmin();
    }

    // ── Video likes (count kept by Cloud Function) ─────────
    match /video_likes/{videoKey} {
      allow read: if true;
      allow write: if isAdmin();
      match /users/{userId} {
        allow read: if signedIn() && uid() == userId;
        allow create: if signedIn() && uid() == userId
          && request.resource.data.keys().hasOnly(['serviceId', 'createdAt']);
        allow delete: if signedIn() && uid() == userId;
      }
    }

    // ── Community help: claim / report / suggest ──────────
    // Owner wants to take over an imported business
    match /claims/{id} {
      allow create: if realUser()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.message.size() <= 2000
        && request.resource.data.name.size() <= 200;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow update, delete: if isAdmin();
    }
    // "Report wrong info" (guests too)
    match /reports/{id} {
      allow create: if request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(
             ['businessId', 'businessName', 'reason', 'note', 'userId', 'status', 'createdAt'])
        && request.resource.data.note.size() <= 1000
        && (request.resource.data.userId == null || (signedIn() && request.resource.data.userId == uid()));
      allow read, update, delete: if isAdmin();
    }
    // Missing business suggested by a user
    match /suggestions/{id} {
      allow create: if realUser()
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.name.size() <= 200
        && request.resource.data.note.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // ── App settings (payment numbers) ─────────────────────
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Users (FCM token etc.) ─────────────────────────────
    match /users/{userId} {
      // "unlocks" is set only by the redeemCode function, never by the app
      allow read: if (signedIn() && uid() == userId) || isAdmin();
      allow create: if signedIn() && uid() == userId
        && !request.resource.data.keys().hasAny(['unlocks', 'unlockPhone']);
      allow update: if signedIn() && uid() == userId
        && !changed().hasAny(['unlocks', 'unlockPhone']);
      allow delete: if signedIn() && uid() == userId;
    }

    // ── Paid content unlocked with a code (see redeemCode) ─
    match /unlock_codes/{code} {
      allow read, write: if isAdmin();
    }
    // Extra driving theory questions: only for users who unlocked theory_pro
    match /theory_pro/{doc} {
      allow read: if isAdmin() || (signedIn()
        && get(/databases/$(database)/documents/users/$(uid())).data.get('unlocks', {}).get('theory_pro', false) == true);
      allow write: if isAdmin();
    }

    // ── Contact form ───────────────────────────────────────
    match /contact_messages/{id} {
      allow create: if request.resource.data.keys().hasAll(['message'])
                    && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // ── Notifications queue ────────────────────────────────
    match /notifications/{id} {
      allow create: if signedIn();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == uid());
      allow update, delete: if isAdmin();
    }

    // ── Travel requests ────────────────────────────────────
    match /travel_requests/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Habesha Books (digital books, read with a verified email) ──
    // authors/{email}: who may upload books — only admin decides
    function verifiedEmail() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isAuthor() { return verifiedEmail() && exists(/databases/$(database)/documents/authors/$(myEmail())); }
    function bookAuthor(bookId) {
      return signedIn() && get(/databases/$(database)/documents/books/$(bookId)).data.authorId == uid();
    }
    function hasBookAccess(bookId) {
      return verifiedEmail() && (
        exists(/databases/$(database)/documents/books/$(bookId)/access/$(myEmail()))
        || exists(/databases/$(database)/documents/books/$(bookId)/domains/$(myEmail().split('@')[1])));
    }
    match /authors/{email} {
      allow read: if isAdmin() || (verifiedEmail() && myEmail() == email);
      allow write: if isAdmin();
    }
    match /books/{bookId} {
      allow read: if resource.data.published == true || isAdmin()
        || (signedIn() && resource.data.authorId == uid());
      allow create: if isAdmin() || (isAuthor()
        && request.resource.data.authorId == uid()
        && request.resource.data.published == false);
      allow update: if isAdmin() || (isAuthor()
        && resource.data.authorId == uid() && request.resource.data.authorId == uid());
      allow delete: if isAdmin() || (isAuthor() && resource.data.authorId == uid());

      // emails that may read this book (doc id = lower-case email)
      match /access/{email} {
        allow read: if isAdmin() || bookAuthor(bookId) || (verifiedEmail() && myEmail() == email);
        allow write: if isAdmin() || (isAuthor() && bookAuthor(bookId));
        // a reader unlocks the book with an unused code from the printed book
        // (same batch marks the code as used by this email)
        allow create: if verifiedEmail() && myEmail() == email
          && request.resource.data.keys().hasOnly(['email', 'code', 'addedAt'])
          && request.resource.data.code is string
          && get(/databases/$(database)/documents/book_codes/$(request.resource.data.code)).data.usedBy == null
          && getAfter(/databases/$(database)/documents/book_codes/$(request.resource.data.code)).data.usedBy == email
          && getAfter(/databases/$(database)/documents/book_codes/$(request.resource.data.code)).data.bookId == bookId;
      }
      // whole school: every verified email @domain may read
      match /domains/{domain} {
        allow read: if isAdmin() || bookAuthor(bookId) || (verifiedEmail() && myEmail().split('@')[1] == domain);
        allow write: if isAdmin() || (isAuthor() && bookAuthor(bookId));
      }
      // interactive lessons (HTML book): readers with access read, the author writes
      match /lessons/{lessonId} {
        allow read: if isAdmin() || bookAuthor(bookId) || hasBookAccess(bookId);
        allow write: if isAdmin() || (isAuthor() && bookAuthor(bookId));
      }
      // reading progress, written by the reader, seen by the author
      match /reads/{email} {
        allow read, delete: if isAdmin() || bookAuthor(bookId);
        allow create, update: if verifiedEmail() && myEmail() == email && hasBookAccess(bookId)
          && request.resource.data.keys().hasOnly(['email', 'lastPage', 'updatedAt'])
          && request.resource.data.email == email && request.resource.data.lastPage is int;
      }
      // workbook pages rebuilt as web content (text, lines, photo keys) — same access as the book
      match /wpages/{pageId} {
        allow read: if isAdmin() || bookAuthor(bookId) || hasBookAccess(bookId);
        allow write: if isAdmin() || (isAuthor() && bookAuthor(bookId));
      }
      // exercise book: what a reader wrote on a page, only they read and write it
      match /ink/{email}/pages/{page} {
        allow read, write: if verifiedEmail() && myEmail() == email
          && (hasBookAccess(bookId) || bookAuthor(bookId) || isAdmin())
          && (request.resource == null || (request.resource.data.keys().hasOnly(['s', 't', 'updatedAt'])
            && request.resource.data.s is string && request.resource.data.s.size() < 900000));
      }
    }

    // one-time unlock codes printed inside the paper book (doc id = code)
    match /book_codes/{code} {
      allow get: if verifiedEmail();
      allow list: if isAdmin() || (signedIn() && resource.data.authorId == uid());
      allow create: if request.resource.data.usedBy == null
        && (isAdmin() || (isAuthor() && request.resource.data.authorId == uid()
                          && bookAuthor(request.resource.data.bookId)));
      allow update: if isAdmin() || (isAuthor() && resource.data.authorId == uid())
        || (verifiedEmail() && resource.data.usedBy == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
            && request.resource.data.usedBy == myEmail()
            && request.resource.data.usedAt == request.time
            && existsAfter(/databases/$(database)/documents/books/$(resource.data.bookId)/access/$(myEmail())));
      allow delete: if isAdmin() || (isAuthor() && resource.data.authorId == uid());
    }
    // devices per reader email: max 3, a reader can add but never remove; authors reset
    match /books_devices/{email} {
      allow read: if isAdmin() || isAuthor() || (verifiedEmail() && myEmail() == email);
      allow create: if verifiedEmail() && myEmail() == email
        && request.resource.data.keys().hasOnly(['email', 'devices'])
        && request.resource.data.devices.size() <= 3;
      allow update: if verifiedEmail() && myEmail() == email
        && request.resource.data.keys().hasOnly(['email', 'devices'])
        && request.resource.data.devices.size() <= 3
        && request.resource.data.devices.keys().hasAll(resource.data.devices.keys());
      allow delete: if isAdmin() || isAuthor();
    }

    // free sample lesson: recorded voices (public), only authors/admin change them
    match /books_sample/{id} {
      allow read: if true;
      allow write: if isAdmin() || isAuthor();
    }

    // ── Everything else (old Connect / Forum / Events) ─────
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
