{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "habesha-hub-7bd1d",
          "appId": "1:308436707340:android:e6c29336bde4c1239ae629",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "habesha-hub-7bd1d",
          "configurations": {
            "android": "1:308436707340:android:e6c29336bde4c1239ae629",
            "ios": "1:308436707340:ios:015ff7e8e5d97aef9ae629",
            "macos": "1:308436707340:ios:015ff7e8e5d97aef9ae629",
            "web": "1:308436707340:web:757a5a02ec6f1ea09ae629",
            "windows": "1:308436707340:web:0e66ab28bf24a9f59ae629"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/p/**",
        "function": {
          "functionId": "providerPage",
          "region": "europe-west1"
        }
      },
      {
        "source": "/b/**",
        "function": {
          "functionId": "businessPage",
          "region": "europe-west1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|json|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^/games/[^.]*$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(mp3|m4a|png|jpg|jpeg|webp|svg|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/yosiefsbook",
        "destination": "/books/",
        "type": 301
      },
      {
        "source": "/yosiefsbook/**",
        "destination": "/books/",
        "type": 301
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "database": {
    "rules": "database.rules.json"
  }
}